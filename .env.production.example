# .env.production.example
# Plantilla de entorno para despliegue (copiar a .env en el servidor y ajustar valores).

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/sgep_db
ALGORITHM=HS256
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://TU_DOMINIO_O_IP:3000

# Seguridad (OBLIGATORIO, >=32 caracteres, valor privado)
SECRET_KEY=cambia_esta_clave_por_una_aleatoria_de_32_o_mas_caracteres

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60

# Email/alertas (activar y configurar SMTP en produccion si aplica)
EMAIL_ACTIVO=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@sgep.local
ALERTAS_INTERVALO_MINUTOS=60

# Housekeeping
REFRESH_PURGA_INTERVALO_MINUTOS=60
BCRYPT_ROUNDS=12
