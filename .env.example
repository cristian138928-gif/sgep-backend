# EXPLICACIÓN: Plantilla de entorno. Copia a .env y completa los valores reales.
# cp .env.example .env

# ---- Conexión ----
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sgep_db
ALGORITHM=HS256
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Seguridad (OBLIGATORIO) ----
# EXPLICACIÓN: minimo 32 caracteres; la app NO arranca sin él (app/config.py)
SECRET_KEY=reemplaza_con_una_clave_aleatoria_de_32_o_mas_caracteres

# ---- Tokens ----
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Rate limiting (anti fuerza bruta) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60

# ---- Email transaccional (evaluaciones) ----
# EXPLICACIÓN: false => los emails solo se loguean (dev/tests sin SMTP)
EMAIL_ACTIVO=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@sgep.local

# ---- Alertas de vencimiento (minutos entre ejecuciones; 0 = apagado) ----
ALERTAS_INTERVALO_MINUTOS=0

# ---- Rendimiento (opcional) ----
# EXPLICACIÓN: 12 = producción; los tests lo bajan a 4 automáticamente
BCRYPT_ROUNDS=12
